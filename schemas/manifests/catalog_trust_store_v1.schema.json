{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/roco-handbook/catalog_trust_store_v1.schema.json",
  "title": "Catalog manifest trust store V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["trust_store_version", "keys"],
  "properties": {
    "trust_store_version": {"const": 1},
    "keys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "algorithm",
          "key_id",
          "public_key",
          "first_release_sequence",
          "last_release_sequence"
        ],
        "properties": {
          "algorithm": {"const": "ed25519"},
          "key_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
          "public_key": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43}$"},
          "first_release_sequence": {"type": "integer", "minimum": 1},
          "last_release_sequence": {
            "oneOf": [
              {"type": "integer", "minimum": 1},
              {"type": "null"}
            ]
          }
        }
      }
    }
  }
}
